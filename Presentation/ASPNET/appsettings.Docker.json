{
  // The Docker environment is the production default. docker-compose.demo.yml sets
  // IsDemoVersion=true explicitly for the self-contained demo stack.
  "IsDemoVersion": false,
  // The connection string is supplied by docker-compose.yml through
  // ConnectionStrings__DefaultConnection, because it contains the SQL Server password.
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5000"
      }
    }
  }
}