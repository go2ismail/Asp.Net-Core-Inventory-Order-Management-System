# ---------------------------------------------------------------------------------------------
# Production template. Copy this file to `.env` in the repository root and replace the placeholder
# values, or run `scripts/new-secrets.ps1` to generate real values and write them to `.env`.
#
# `.env` is ignored by git and by Docker, so the real secrets never reach the repository,
# the CI logs, or an image. `.env.example` is the only version that is committed.
#
# The demo mode of appsettings.json (IsDemoVersion=true) does not need this file: a fresh clone
# starts with the documented demo key and admin@root.com / 123456. A production deployment must
# set IsDemoVersion=false and provide both secrets below.
# ---------------------------------------------------------------------------------------------

# Production mode. appsettings.json defaults to true for the live demo and clone-and-run.
IsDemoVersion=false

# Signing key of the access tokens (Jwt:Key). At least 32 bytes, unique per environment.
Jwt__Key=replace-with-a-random-secret-of-at-least-32-bytes

# ---------------------------------------------------------------------------------------------
# Administrator account (AspNetIdentity:DefaultAdmin)
# ---------------------------------------------------------------------------------------------
# The account is created on the very first start up, when the database has no roles yet.
# The email is not a secret, the password is. At least 12 characters, unique per environment,
# and it must differ from the value that earlier releases published (that value is rejected).
# An installation that still stores the published password rotates it to this value on start up.
AspNetIdentity__DefaultAdmin__Email=admin@root.com
AspNetIdentity__DefaultAdmin__Password=replace-with-a-strong-password-of-at-least-12-characters
