# ---------------------------------------------------------------------------------------------
# Copy this file to `.env` in the repository root and replace the placeholder value.
# `.env` is ignored by git and by Docker, so the real secret never reaches the repository,
# the CI logs, or an image. `.env.example` is the only version that is committed.
#
# Generate a key with:  powershell -NoProfile -ExecutionPolicy Bypass -File scripts/new-jwt-key.ps1
#
# The key format is the same as an environment variable: a double underscore is the section
# separator, so `Jwt__Key` overrides `Jwt:Key` from appsettings.json.
# Real environment variables always win over the values in this file.
# ---------------------------------------------------------------------------------------------

# Signing key of the access tokens (Jwt:Key). At least 32 bytes, unique per environment.
Jwt__Key=replace-with-a-random-secret-of-at-least-32-bytes
